{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopify-cloudflare-app",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: the Shopify libraries reach for a few Node built-ins, and
  // app/request-context.server.ts uses node:async_hooks (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    // Bound so the Worker can serve a static asset in-process
    // (env.ASSETS.fetch) without a network self-fetch, which would re-enter
    // this Worker and loop.
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Daily housekeeping. workers/app.ts `scheduled` prunes password-reset tokens
  // that expired long ago; add your own sweeps to the same handler.
  "triggers": { "crons": ["30 3 * * *"] },

  // ─────────────────────────── LOCAL DEV + TESTS ───────────────────────────
  // This top-level config is for Miniflare (`npm run dev`, vitest) only.
  // Miniflare simulates each binding by its NAME and ignores the ids below, so
  // they are placeholders. Production has its own real resources under
  // `env.production` — never run a `--remote` command against this env.

  // Shopify session storage — see app/session-storage.server.ts.
  "kv_namespaces": [
    { "binding": "SESSION", "id": "0000000000000000000000000000000d" }
  ],

  // Transactional email (password resets, notifications) — env.EMAIL.send().
  // `remote: true` means a send during `npm run dev` goes through the REAL
  // service, so it needs `wrangler login`. Nothing is sent until the sending
  // domain is onboarded: `npx wrangler email sending enable yourdomain.com`.
  // Tests keep this SIMULATED — vitest.config.ts pins remoteBindings: false.
  "send_email": [{ "name": "EMAIL", "remote": true }],

  // All app state. Migrations are generated by drizzle-kit into ./drizzle.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  // Secret NAMES, declared rather than inferred. Values never live here.
  //
  // Without this, `wrangler types` infers the secret half of `Env` from
  // `.dev.vars` — which is gitignored, so on a fresh clone or a CI runner these
  // three vanish from the generated `Env` and the app stops compiling
  // (`Property 'SHOPIFY_API_SECRET' does not exist on type 'Env'`). Declaring
  // them "replaces .dev.vars/.env/process.env inference for type generation"
  // and warns in local dev when one is missing.
  //
  // It also removes the trap in the workaround: copying the template with blank
  // values makes `SHOPIFY_API_SECRET=` a DEFINED empty string, which shadows the
  // real one `shopify app dev` injects — and the app then fails at the first
  // request with "Missing values for: apiSecretKey", nowhere near the cause.
  "secrets": {
    "required": [
      "SHOPIFY_API_SECRET",
      "SHOP_CUSTOM_DOMAIN",
      "INTERNAL_SESSION_SECRET"
    ]
  },

  // Non-secret vars. SHOPIFY_API_KEY is the public client_id — `shopify app
  // dev` injects the real one (plus the live tunnel URL) via vite.config.ts,
  // overriding these local fallbacks. Secrets go in .dev.vars locally and
  // `wrangler secret put` remotely.
  "vars": {
    "SHOPIFY_API_KEY": "",
    "SCOPES": "",
    "SHOPIFY_APP_URL": "http://localhost:3000",
    // Must be an address on a domain onboarded to Email Sending. Empty means
    // email is disabled and sendEmail() reports notConfigured.
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": ""
  },

  // ─────────────────────────── PRODUCTION ───────────────────────────
  // `wrangler deploy --env production` (npm run cf:deploy). Wrangler
  // environments do NOT inherit bindings/vars/triggers/routes from the top
  // level, so every one is re-declared here in full. (main, compatibility_date,
  // compatibility_flags and assets ARE inherited.)
  "env": {
    "production": {
      "observability": { "enabled": true },
      "kv_namespaces": [
        // Replace with the real id: `wrangler kv namespace create SESSION`
        { "binding": "SESSION", "id": "REPLACE_ME" }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["30 3 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-db-prod",
          // Replace with the real id: `wrangler d1 create app-db-prod`
          "database_id": "REPLACE_ME",
          "migrations_dir": "drizzle"
        }
      ],
      // NOT inherited from the top level — the schema is explicit that `secrets`
      // "must be specified in every named environment". Omit it here and
      // production types itself from inference again.
      "secrets": {
        "required": [
          "SHOPIFY_API_SECRET",
          "SHOP_CUSTOM_DOMAIN",
          "INTERNAL_SESSION_SECRET"
        ]
      },
      "vars": {
        // The production client_id, from shopify.app.toml.
        "SHOPIFY_API_KEY": "",
        "SCOPES": "",
        // Your production URL — must match application_url in shopify.app.toml.
        "SHOPIFY_APP_URL": "https://example.com",
        "EMAIL_FROM": "",
        "EMAIL_FROM_NAME": ""
      }
    }
  }
}
