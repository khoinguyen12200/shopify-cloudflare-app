{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopify-cloudflare-app",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: the Shopify libraries reach for a few Node built-ins, and
  // app/request-context.server.ts uses node:async_hooks (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    // Bound so the Worker can serve a static asset in-process
    // (env.ASSETS.fetch) without a network self-fetch, which would re-enter
    // this Worker and loop.
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // ─────────────────────────── LOCAL DEV + TESTS ───────────────────────────
  // This top-level config is for Miniflare (`npm run dev`, vitest) only.
  // Miniflare simulates each binding by its NAME and ignores the ids below, so
  // they are placeholders. Production has its own real resources under
  // `env.production` — never run a `--remote` command against this env.

  // Shopify session storage — see app/session-storage.server.ts.
  "kv_namespaces": [
    { "binding": "SESSION", "id": "0000000000000000000000000000000d" }
  ],

  // All app state. Migrations are generated by drizzle-kit into ./drizzle.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  // Non-secret vars. SHOPIFY_API_KEY is the public client_id — `shopify app
  // dev` injects the real one (plus the live tunnel URL) via vite.config.ts,
  // overriding these local fallbacks. Secrets go in .dev.vars locally and
  // `wrangler secret put` remotely.
  "vars": {
    "SHOPIFY_API_KEY": "",
    "SCOPES": "",
    "SHOPIFY_APP_URL": "http://localhost:3000"
  },

  // ─────────────────────────── PRODUCTION ───────────────────────────
  // `wrangler deploy --env production` (npm run cf:deploy). Wrangler
  // environments do NOT inherit bindings/vars/triggers/routes from the top
  // level, so every one is re-declared here in full. (main, compatibility_date,
  // compatibility_flags and assets ARE inherited.)
  "env": {
    "production": {
      "observability": { "enabled": true },
      "kv_namespaces": [
        // Replace with the real id: `wrangler kv namespace create SESSION`
        { "binding": "SESSION", "id": "REPLACE_ME" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-db-prod",
          // Replace with the real id: `wrangler d1 create app-db-prod`
          "database_id": "REPLACE_ME",
          "migrations_dir": "drizzle"
        }
      ],
      "vars": {
        // The production client_id, from shopify.app.toml.
        "SHOPIFY_API_KEY": "",
        "SCOPES": "",
        // Your production URL — must match application_url in shopify.app.toml.
        "SHOPIFY_APP_URL": "https://example.com"
      }
    }
  }
}
