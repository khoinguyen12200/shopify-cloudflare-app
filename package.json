{
  "name": "shopify-cloudflare-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "verify": "npm run typecheck && npm run lint && npm test",
    "precommit": "npm run verify",
    "dev": "node scripts/shopify.mjs app dev --config dev",
    "predev": "npm run db:migrate:local && npm run db:seed",
    "dev:local": "react-router dev",
    "predev:local": "npm run db:migrate:local && npm run db:seed",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate.mjs --local --database app-db",
    "db:migrate": "node scripts/migrate.mjs --remote --env production --database app-db-prod",
    "cf:build": "npm run verify && CLOUDFLARE_ENV=production npm run build",
    "cf:deploy": "npm run check:placeholders && npm run cf:build && npm run db:migrate && wrangler deploy -c build/server/wrangler.json",
    "shopify": "node scripts/shopify.mjs",
    "config:link:dev": "node scripts/shopify.mjs app config link --config dev",
    "config:link:prod": "node scripts/shopify.mjs app config link",
    "config:use:dev": "node scripts/shopify.mjs app config use shopify.app.dev.toml",
    "config:use:prod": "node scripts/shopify.mjs app config use shopify.app.toml",
    "generate": "node scripts/shopify.mjs app generate --config dev",
    "deploy:dev": "node scripts/shopify.mjs app deploy --config dev",
    "deploy:prod": "node scripts/shopify.mjs app deploy --config shopify.app.toml",
    "env": "node scripts/shopify.mjs app env",
    "shopify:logout": "node scripts/shopify.mjs auth logout",
    "graphql-codegen": "graphql-codegen",
    "install:skill": "node scripts/install-skills.mjs",
    "db:seed": "node scripts/seed-admin.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs production"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-router/dev": "^7.18.2",
    "@shopify/app-bridge-react": "^4.2.12",
    "@shopify/shopify-api": "^14.0.0",
    "@shopify/shopify-app-react-router": "^2.0.0",
    "@shopify/shopify-app-session-storage": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.4.0",
    "isbot": "^5.2.1",
    "lucide-react": "^1.33.0",
    "ngk-dashboard": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "^7.18.2",
    "remix-i18next": "^7.5.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/cli": "^4.7.0",
    "@shopify/polaris-types": "^1.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "graphql-config": "^5.1.6",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "skills": "^1.5.23",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@shopify/graphql-codegen": {
      "lodash": "^4.18.1"
    }
  }
}
